<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>DestinationHome.Catalogue</AssemblyName>
    <ApplicationIcon>Assets\catalogue.ico</ApplicationIcon>
    <RootNamespace>DestinationHome.Catalogue</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\catalogue.ico" LogicalName="DestinationHome.Catalogue.CatalogueIcon" />
    <EmbeddedResource Include="Assets\catalogue-icon.png" LogicalName="DestinationHome.Catalogue.CatalogueArtwork" />
  </ItemGroup>
</Project>
